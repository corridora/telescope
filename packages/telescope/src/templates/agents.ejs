<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Telescope remote execution</title>
    <style>
      :root{font:16px/1.5 system-ui,sans-serif;color:#172033;background:#f4f6fa}*{box-sizing:border-box}body{margin:0}main{max-width:1100px;margin:auto;padding:2rem}nav,.actions{display:flex;gap:1rem;flex-wrap:wrap}a{color:#1559b7}h1{margin-bottom:.35rem}h2{margin-top:0}.card{background:white;border:1px solid #d5dce7;border-radius:.75rem;padding:1.5rem;margin:1.25rem 0}label{display:grid;gap:.4rem;font-weight:600;margin:.8rem 0}input,select,textarea{width:100%;padding:.65rem;font:inherit;border:1px solid #a6b2c4;border-radius:.4rem}textarea{resize:vertical}button{padding:.65rem 1rem;font:inherit;border:1px solid #a6b2c4;border-radius:.4rem;background:#edf3ff;cursor:pointer}button:disabled{opacity:.5;cursor:default}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 1rem}.hint{font-size:.9rem;color:#5d697b}.entry{border-bottom:1px solid #e0e5ed;padding:1rem 0}.entry:last-child{border-bottom:0}.entry h3,.entry p{margin:.4rem 0}#notice{min-height:1.5rem;white-space:pre-wrap}.error{color:#a32c1e}code{overflow-wrap:anywhere}[hidden]{display:none!important}details{margin:1rem 0}
    </style>
  </head>
  <body>
    <main id="remote-workspace" data-mode="<%= mode %>" data-job-id="<%= jobId %>">
      <nav><a href="/">Local workspace</a><a href="/run">Remote run</a><a href="/agents">Agents</a></nav>
      <h1><%= mode === 'agents' ? 'Remote agents' : mode === 'job' ? 'Remote test run' : 'Run a remote test' %></h1>
      <p class="hint">The web UI instance stores accepted results. An agent supplies browser execution and access to its target network.</p>
      <form id="session" class="card"><h2>Workspace authentication</h2><label>Local workspace token<input id="token" type="password" required autocomplete="current-password" /></label><button>Unlock remote execution</button></form>
      <p id="notice" role="status" aria-live="polite"></p>
      <div id="content" hidden>
        <% if (mode === 'agents') { %>
          <form id="enroll" class="card"><h2>Enroll an agent</h2><label>Name<input name="name" maxlength="100" required placeholder="Office runner" /></label><button>Create credential</button><div id="credential" hidden><p>Save this credential in a private file on the agent. It is shown once.</p><textarea id="credential-value" readonly rows="3" aria-label="New agent credential"></textarea><p class="hint">Start the agent with <code>telescope agent --controller https://your-instance --tokenFile ./agent.token --allowHosts example.com</code>. For an explicitly trusted HTTP Docker development network, use <code>--allowInsecureHttp</code>.</p></div></form>
          <section class="card"><h2>Agents</h2><div id="agents"></div></section>
        <% } else if (mode === 'run') { %>
          <form id="run" class="card"><h2>Run on an agent</h2><label>Target URL<input name="url" type="url" required placeholder="https://example.com" /></label><p class="hint">The agent reaches this URL. Localhost and private names refer to the agent's environment.</p><div class="grid"><label>Agent<select name="agentId" id="agent" required></select></label><label>Browser<select name="browser" id="browser" required></select></label><label>Device<select name="device" id="device"><option value="">Default viewport</option></select></label><label>Trusted script<select name="scriptId" id="script"><option value="">Single page</option></select></label><label>Name<input name="name" maxlength="200" /></label><label>Timeout in milliseconds<input name="timeout" type="number" min="1" max="300000" value="30000" required /></label><label>Script deadline in milliseconds<input name="scriptTimeout" type="number" min="1" max="3600000" value="300000" /></label></div><label>Description<textarea name="description" maxlength="4000" rows="2"></textarea></label><details><summary>Advanced JSON options</summary><p class="hint">Scripts are provisioned by the agent operator. Output paths, browser process flags, and result destinations are controlled by the instance.</p><textarea name="advanced" rows="5">{}</textarea></details><button>Run test</button></form>
          <section class="card"><h2>Recent runs</h2><div id="jobs"></div></section>
        <% } else { %>
          <section class="card"><h2>Run progress</h2><p class="hint">Job <code><%= jobId %></code></p><div id="job"></div><div class="actions"><button id="cancel">Cancel</button><button id="retry">Retry failed run</button></div><h3>Attempts</h3><div id="attempts"></div></section>
        <% } %>
      </div>
    </main>
    <script>
      (()=>{
        const root=document.getElementById('remote-workspace'),mode=root.dataset.mode,jobId=root.dataset.jobId;
        const notice=document.getElementById('notice'),session=document.getElementById('session'),content=document.getElementById('content');
        let authenticated=false,refreshing=false,agents=[],requestKey=crypto.randomUUID(),sessionToken='';try{sessionToken=sessionStorage.getItem('telescope-session')||'';}catch{}
        function say(message,error=false){notice.textContent=message;notice.className=error?'error':'';}
        async function api(url,method='GET',body,headers={}){const credential=sessionToken?{'X-Telescope-Token':sessionToken}:{};const response=await fetch(url,{method,credentials:'same-origin',headers:body===undefined?{...credential,...headers}:{'Content-Type':'application/json',...credential,...headers},body:body===undefined?undefined:JSON.stringify(body)});const data=await response.json();if(!response.ok)throw new Error(data.error||`Request failed (${response.status})`);return data;}
        function node(tag,text,className){const value=document.createElement(tag);value.textContent=text;if(className)value.className=className;return value;}
        function link(text,url){const value=node('a',text);value.href=url;return value;}
        function button(text,callback){const value=node('button',text);value.addEventListener('click',()=>{value.disabled=true;Promise.resolve().then(callback).catch(error=>say(error.message,true)).finally(()=>value.disabled=false);});return value;}
        function showCredential(data){document.getElementById('credential-value').value=data.token;document.getElementById('credential').hidden=false;}
        function setBrowsers(){const selected=document.getElementById('agent'),browser=document.getElementById('browser');if(!selected||!browser)return;const capabilities=agents.find(agent=>agent.id===selected.value)?.capabilities||{},old=browser.value;browser.replaceChildren();for(const name of capabilities.browsers||[]){const item=node('option',name);item.value=name;browser.append(item);}if([...browser.options].some(item=>item.value===old))browser.value=old;for(const [id,empty,values] of [['device','Default viewport',(capabilities.devices||[]).map(name=>({id:name,name}))],['script','Single page',capabilities.scripts||[]]]){const control=document.getElementById(id),previous=control.value,option=node('option',empty);option.value='';control.replaceChildren(option);for(const entry of values){const item=node('option',entry.name||entry.id);item.value=entry.id;control.append(item);}if([...control.options].some(item=>item.value===previous))control.value=previous;}}
        async function refreshAgents(){const data=await api('/api/agents');agents=data.agents;const list=document.getElementById('agents');if(list){list.replaceChildren();if(!agents.length)list.append(node('p','No enrolled agents.'));for(const agent of agents){const entry=node('div','','entry');entry.append(node('h3',agent.name),node('p',`${agent.status} · ${agent.online?'online':'offline'} · ${agent.capabilities.platform||'not registered'} ${agent.capabilities.architecture||''}`),node('p',`Browsers: ${(agent.capabilities.browsers||[]).join(', ')||'none reported'}`));if(agent.status!=='revoked'){const controls=node('div','','actions');controls.append(button(agent.status==='draining'?'Activate':'Drain',async()=>{await api(`/api/agents/${agent.id}/${agent.status==='draining'?'activate':'drain'}`,'POST',{});await refreshAgents();}),button('Rotate credential',async()=>{if(!confirm('Rotate this credential? Restart the agent with its replacement.'))return;showCredential(await api(`/api/agents/${agent.id}/rotate`,'POST',{}));await refreshAgents();}),button('Revoke',async()=>{if(!confirm('Revoke this agent? Saved results remain available.'))return;await api(`/api/agents/${agent.id}/revoke`,'POST',{});await refreshAgents();}));entry.append(controls);}list.append(entry);}}const select=document.getElementById('agent');if(select){const old=select.value;select.replaceChildren();for(const agent of agents.filter(agent=>agent.status==='active')){const item=node('option',`${agent.name} — ${agent.online?'online':'offline; will queue'}`);item.value=agent.id;select.append(item);}if(agents.some(agent=>agent.id===old))select.value=old;setBrowsers();}}
        async function refreshJobs(){const list=document.getElementById('jobs');if(!list)return;const data=await api('/api/runs');list.replaceChildren();if(!data.jobs.length)list.append(node('p','No remote jobs yet.'));for(const job of data.jobs){const entry=node('div','','entry');entry.append(link(job.name||job.id,`/runs/${job.id}`),node('p',`${job.execution_state} · delivery ${job.delivery_state} · ${job.agent_name||''}`),node('p',new Date(job.created_at).toLocaleString()));list.append(entry);}}
        async function refreshJob(){const detail=document.getElementById('job');if(!detail)return;const data=await api(`/api/runs/${encodeURIComponent(jobId)}`),job=data.job;detail.replaceChildren(node('h3',job.name||'Unnamed test'),node('p',`Execution: ${job.execution_state}`),node('p',`Delivery: ${job.delivery_state}`));if(job.cancel_requested)detail.append(node('p','Cancellation requested.'));if(job.error)detail.append(node('p',job.error,'error'));if(job.delivery_error)detail.append(node('p',`Result delivery: ${job.delivery_error}`,'error'));document.getElementById('cancel').disabled=['passed','failed','cancelled','interrupted'].includes(job.execution_state);document.getElementById('retry').disabled=!['failed','cancelled','interrupted'].includes(job.execution_state);const list=document.getElementById('attempts');list.replaceChildren();for(const attempt of data.attempts){const entry=node('div','','entry');entry.append(node('p',`${new Date(attempt.created_at).toLocaleString()} · ${attempt.execution_state} · ${attempt.delivery_state}`));if(attempt.progress)entry.append(node('p',`Phase: ${attempt.progress.phase||'working'}`));if(attempt.error)entry.append(node('p',attempt.error,'error'));if(attempt.delivery_error)entry.append(node('p',`Result delivery: ${attempt.delivery_error}`,'error'));if(attempt.receipt?.stored)entry.append(link('Open saved result',attempt.receipt.resultUrl||`/#result/${encodeURIComponent(attempt.receipt.resultId)}`));list.append(entry);}}
        async function refresh(){if(!authenticated||refreshing)return;refreshing=true;try{if(mode==='job')await refreshJob();else{await refreshAgents();if(mode==='run')await refreshJobs();}}catch(error){say(error.message,true);}finally{refreshing=false;}}
        session.addEventListener('submit',event=>{event.preventDefault();const token=document.getElementById('token');fetch('/api/local/session',{method:'POST',credentials:'same-origin',headers:{'X-Telescope-Token':token.value}}).then(async response=>{const data=await response.json();if(!response.ok)throw new Error(data.error||'Authentication failed');sessionToken=data.token||token.value;try{sessionStorage.setItem('telescope-session',sessionToken);}catch{}token.value='';authenticated=true;session.hidden=true;content.hidden=false;say('Workspace unlocked.');await refresh();}).catch(error=>say(error.message,true));});
        document.getElementById('enroll')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget,submit=form.querySelector('button');submit.disabled=true;api('/api/agents','POST',{name:new FormData(form).get('name')}).then(async data=>{showCredential(data);await refreshAgents();}).catch(error=>say(error.message,true)).finally(()=>submit.disabled=false);});
        const run=document.getElementById('run');run?.addEventListener('input',()=>requestKey=crypto.randomUUID());run?.addEventListener('submit',event=>{event.preventDefault();const fields=new FormData(run),submit=run.querySelector('button');submit.disabled=true;Promise.resolve().then(async()=>{let extra;try{extra=JSON.parse(fields.get('advanced')||'{}');}catch{throw new Error('Advanced options must be valid JSON');}if(!extra||typeof extra!=='object'||Array.isArray(extra))throw new Error('Advanced options must be an object');const selected=agents.find(agent=>agent.id===fields.get('agentId')),script=(selected?.capabilities.scripts||[]).find(item=>item.id===fields.get('scriptId'));const data=await api('/api/runs','POST',{agentId:fields.get('agentId'),name:fields.get('name')||undefined,description:fields.get('description')||undefined,options:{...extra,url:fields.get('url'),browser:fields.get('browser'),device:fields.get('device')||undefined,timeout:Number(fields.get('timeout')),scriptId:script?.id,scriptHash:script?.sha256,scriptTimeout:script?Number(fields.get('scriptTimeout')):undefined}},{'Idempotency-Key':requestKey});location.href=`/runs/${encodeURIComponent(data.jobId)}`;}).catch(error=>say(error.message,true)).finally(()=>submit.disabled=false);});
        document.getElementById('agent')?.addEventListener('change',setBrowsers);
        document.getElementById('cancel')?.addEventListener('click',()=>api(`/api/runs/${encodeURIComponent(jobId)}/cancel`,'POST',{}).then(refreshJob).catch(error=>say(error.message,true)));
        document.getElementById('retry')?.addEventListener('click',()=>{if(confirm('Start another attempt? Prior target actions may already have occurred.'))api(`/api/runs/${encodeURIComponent(jobId)}/retry`,'POST',{}).then(refreshJob).catch(error=>say(error.message,true));});
        api('/api/local/session').then(async data=>{if(data.token){sessionToken=data.token;try{sessionStorage.setItem('telescope-session',sessionToken);}catch{}}await api('/api/local/session','POST');authenticated=true;session.hidden=true;content.hidden=false;await refresh();}).catch(()=>{});
        setInterval(()=>{if(!document.hidden)void refresh();},4000);
      })();
    </script>
  </body>
</html>
