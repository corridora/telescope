<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title><%= title %></title>
    <style>
      :root { color-scheme: light dark; --bg:#f5f6f8; --surface:#fff; --text:#17202c; --muted:#667085; --line:#dde3eb; --accent:#bc4d16; --soft:#fff3e9; --good:#197646; --bad:#bc3434; --shadow:0 8px 30px #17202c08; font:15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; }
      @media(prefers-color-scheme:dark) { :root { --bg:#10151c; --surface:#18212c; --text:#edf2f7; --muted:#a5b1c2; --line:#354150; --accent:#ffab76; --soft:#36271f; --good:#85d6a8; --bad:#ff9e9e; --shadow:none; } }
      * { box-sizing:border-box; } body { margin:0; background:var(--bg); color:var(--text); } button,input,select,textarea { font:inherit; } button,a,input,select,textarea { -webkit-tap-highlight-color:transparent; } button,a { touch-action:manipulation; } button { cursor:pointer; } button:disabled { cursor:wait; opacity:.55; } a { color:var(--accent); text-underline-offset:.2em; } button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible { outline:3px solid var(--accent); outline-offset:3px; } [hidden] { display:none!important; }
      header { background:var(--surface); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:5; } .header-inner { max-width:1420px; margin:auto; padding:18px 30px; display:flex; align-items:center; gap:30px; } .brand { color:var(--text); font-size:21px; font-weight:750; text-decoration:none; letter-spacing:-.6px; display:flex; align-items:center; gap:10px; } .brand-mark { color:var(--accent); font-size:26px; } .local-label { margin-left:auto; color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.12em; } nav { display:flex; gap:6px; } nav button { border:0; border-radius:7px; background:transparent; padding:8px 13px; color:var(--muted); } nav button[aria-current=page] { color:var(--accent); background:var(--soft); font-weight:650; }
      main { max-width:1420px; margin:0 auto; padding:34px 30px 70px; } h1 { font-size:30px; letter-spacing:-1px; margin:0 0 7px; line-height:1.25; } h2 { font-size:19px; letter-spacing:-.3px; margin:0 0 15px; } h3 { font-size:15px; margin:0 0 12px; } p { margin:0 0 15px; } .muted { color:var(--muted); } .page-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:26px; } .panel { border:1px solid var(--line); border-radius:12px; background:var(--surface); padding:24px; box-shadow:var(--shadow); } .stack { display:grid; gap:20px; } .run-layout { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(300px,1fr); gap:24px; align-items:start; } .form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; } .wide { grid-column:1/-1; } label { display:grid; gap:7px; font-size:13px; font-weight:600; } input,select,textarea { width:100%; border:1px solid var(--line); color:var(--text); background:var(--bg); border-radius:7px; padding:10px 12px; min-width:0; } input::placeholder,textarea::placeholder { color:var(--muted); } textarea { min-height:110px; resize:vertical; font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace; } small,.help { font-size:12px; color:var(--muted); font-weight:400; } .help { margin:8px 0 0; } details { border-top:1px solid var(--line); padding-top:16px; margin-top:20px; } summary { cursor:pointer; font-size:13px; font-weight:650; } details .form-grid { margin-top:16px; } .actions { display:flex; gap:10px; flex-wrap:wrap; align-items:center; } .form-actions { margin-top:25px; justify-content:space-between; } .button { display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:7px; background:var(--surface); padding:8px 13px; color:var(--text); text-decoration:none; font-weight:600; font-size:13px; line-height:1.6; white-space:nowrap; } .button:hover { border-color:var(--muted); } .button.primary { background:var(--accent); border-color:var(--accent); color:var(--surface); } .button.danger { color:var(--bad); } .button.small { padding:5px 10px; font-size:12px; } .notice { padding:13px 16px; background:var(--soft); border:1px solid var(--line); border-radius:9px; margin-bottom:24px; overflow-wrap:anywhere; } .notice.error { border-color:var(--bad); color:var(--bad); background:var(--surface); } .notice.success { border-color:var(--good); color:var(--good); background:var(--surface); } .empty { padding:38px 20px; color:var(--muted); text-align:center; } .empty p { margin:5px 0 15px; } .status { display:inline-flex; align-items:center; border:1px solid var(--line); border-radius:30px; padding:2px 9px; color:var(--muted); font-size:11px; font-weight:650; white-space:nowrap; text-transform:capitalize; } .status.passed,.status.completed { color:var(--good); } .status.failed,.status.interrupted { color:var(--bad); } .status.running,.status.queued,.status.finalizing { color:var(--accent); } .job-row { display:grid; gap:9px; padding:14px 0; border-top:1px solid var(--line); } .job-row:first-child { padding-top:0; border:0; } .job-top { display:flex; justify-content:space-between; align-items:center; gap:12px; } .job-url { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; } .job-meta { display:flex; justify-content:space-between; gap:10px; align-items:center; color:var(--muted); font-size:12px; } .job-error { color:var(--bad); font-size:12px; overflow-wrap:anywhere; } .toolbar { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px; } .toolbar input { max-width:380px; } .toolbar select { max-width:180px; } .count { color:var(--muted); font-size:12px; margin-left:auto; } .result-list,.definition-list { display:grid; gap:14px; } .result-item { display:grid; grid-template-columns:118px minmax(0,1fr) auto; align-items:center; gap:20px; padding:17px; } .result-thumb { display:flex; align-items:center; justify-content:center; width:118px; height:76px; background:var(--bg); overflow:hidden; border:1px solid var(--line); border-radius:7px; color:var(--muted); font-size:11px; } .result-thumb img { width:100%; height:100%; object-fit:cover; object-position:top; } .result-name { font-size:15px; font-weight:650; overflow-wrap:anywhere; } .result-url { color:var(--muted); font-size:12px; overflow-wrap:anywhere; } .result-meta { display:flex; align-items:center; gap:12px; flex-wrap:wrap; font-size:11px; color:var(--muted); margin-top:8px; } .definition-item { display:flex; gap:20px; align-items:center; justify-content:space-between; } .definition-item p { margin:4px 0; } .result-heading { overflow-wrap:anywhere; } .breadcrumbs { margin-bottom:16px; } .step-list { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:22px; } .step-button { max-width:280px; white-space:normal; text-align:left; } .step-button[aria-pressed=true] { border-color:var(--accent); background:var(--soft); } .step-button .status { margin-left:7px; } .overview { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(220px,.7fr); gap:22px; margin:20px 0; } .metric-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; } .metric { border:1px solid var(--line); border-radius:9px; background:var(--surface); padding:18px; min-width:0; } .metric-label { display:block; color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.05em; } .metric-value { display:block; font-size:25px; letter-spacing:-.7px; line-height:1.6; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; } .metric-note { color:var(--muted); font-size:11px; } .screenshot { padding:0; min-height:170px; display:flex; justify-content:center; align-items:center; overflow:hidden; } .screenshot img { width:100%; max-height:330px; object-fit:contain; object-position:top; } .diagnostic-tabs { display:flex; flex-wrap:wrap; border-bottom:1px solid var(--line); margin-bottom:20px; gap:4px; } .diagnostic-tabs button { border:0; border-bottom:2px solid transparent; background:transparent; color:var(--muted); padding:12px 14px; font-size:12px; font-weight:650; } .diagnostic-tabs button[aria-selected=true] { color:var(--accent); border-bottom-color:var(--accent); } .table-scroll { overflow:auto; max-height:660px; } table { border-collapse:collapse; width:100%; font-size:12px; font-variant-numeric:tabular-nums; } th { text-align:left; color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.06em; background:var(--surface); position:sticky; top:0; z-index:1; } th,td { padding:11px 12px; border-bottom:1px solid var(--line); vertical-align:top; } td.long { max-width:360px; overflow-wrap:anywhere; } td.numeric { text-align:right; white-space:nowrap; } .table-caption { color:var(--muted); margin:0 0 13px; font-size:12px; } .wf-track { position:relative; height:16px; min-width:260px; background:var(--bg); border-radius:3px; } .wf-bar { position:absolute; height:12px; top:2px; border-radius:2px; background:var(--accent); min-width:2px; } .wf-bar.failed { background:var(--bad); } .console-row { border-bottom:1px solid var(--line); padding:12px 0; display:grid; grid-template-columns:65px minmax(0,1fr); gap:14px; font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace; } .console-row:last-child { border:0; } .console-row.error { color:var(--bad); } .console-row.warn,.console-row.warning { color:var(--accent); } .console-text { white-space:pre-wrap; overflow-wrap:anywhere; } .console-source { color:var(--muted); font-size:10px; } .filmstrip { display:flex; gap:12px; overflow:auto; padding:4px 0 15px; } .frame { flex:0 0 145px; margin:0; } .frame img { width:145px; height:105px; object-fit:contain; border:1px solid var(--line); border-radius:5px; background:var(--bg); } .frame figcaption { text-align:center; color:var(--muted); font-size:10px; padding-top:5px; } video { width:100%; max-height:620px; background:#000; border-radius:8px; } .subsection { margin-bottom:26px; } .subsection:last-child { margin:0; } .kv { display:grid; grid-template-columns:minmax(140px,.5fr) minmax(0,1fr); gap:0 20px; font-size:12px; } .kv dt,.kv dd { margin:0; padding:9px 0; border-bottom:1px solid var(--line); overflow-wrap:anywhere; } .kv dt { color:var(--muted); } .pagination { display:flex; justify-content:center; align-items:center; gap:16px; margin-top:20px; color:var(--muted); font-size:12px; } .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; } footer { color:var(--muted); font-size:11px; margin-top:28px; } .progress-line { height:4px; background:var(--line); border-radius:3px; overflow:hidden; } .progress-line.active:before { content:''; display:block; background:var(--accent); height:100%; width:30%; animation:slide 1.6s ease-in-out infinite; } @keyframes slide { 0% { transform:translateX(-100%); } 100% { transform:translateX(440%); } } @media(prefers-reduced-motion:reduce) { .progress-line.active:before { animation:none; width:100%; opacity:.55; } }
      @media(max-width:1000px) { .run-layout { grid-template-columns:minmax(0,1fr); } .overview { grid-template-columns:1fr; } .screenshot { max-height:330px; } .result-item { grid-template-columns:90px minmax(0,1fr); } .result-thumb { width:90px; height:65px; } .result-item>.actions { grid-column:2; } } @media(max-width:600px) { .header-inner { padding:14px 16px; gap:14px; flex-wrap:wrap; } .brand { font-size:18px; } nav { order:3; width:100%; } nav button { flex:1; } .local-label { font-size:10px; } main { padding:24px 16px 50px; } h1 { font-size:25px; } .panel { padding:18px; } .form-grid { grid-template-columns:1fr; } .wide { grid-column:auto; } .page-head { flex-direction:column; } .metric-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .metric { padding:13px; } .metric-value { font-size:22px; } .result-item { padding:13px; gap:12px; } .definition-item { flex-direction:column; align-items:flex-start; } .toolbar input,.toolbar select { max-width:none; flex:1 1 100%; } .count { margin-left:0; } .diagnostic-tabs button { padding:9px; } .kv { grid-template-columns:110px minmax(0,1fr); } }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a class="brand" href="#run"><span class="brand-mark" aria-hidden="true">◉</span> Telescope</a>
        <nav aria-label="Main navigation">
          <button type="button" data-page="run" aria-current="page">Run test</button>
          <button type="button" data-page="history">Results</button>
          <button type="button" data-page="saved">Saved tests</button>
          <button type="button" data-page="forwarding">Forwarding</button>
          <a class="button small" href="/agents">Agents</a>
          <a class="button small" href="/run">Remote test</a>
        </nav>
        <span class="local-label">Local workspace</span>
      </div>
    </header>
    <main>
      <div id="notice" class="notice" role="status" hidden></div>
      <section id="session-gate" class="panel" style="max-width:560px;margin:40px auto" hidden aria-labelledby="session-title"><h1 id="session-title">Open this workspace</h1><p class="muted">Use the session token from Telescope's startup address to access this workspace.</p><form id="session-form"><label>Session token<input id="session-token" type="password" autocomplete="off" required /></label><div class="actions" style="margin-top:20px"><button class="button primary" type="submit">Open workspace</button></div></form></section>
      <section id="page-run" aria-labelledby="run-title">
        <div class="page-head"><div><h1 id="run-title">Run a performance test</h1><p class="muted">Use a real browser. Keep the results on this machine.</p></div></div>
        <div class="run-layout">
          <form id="run-form" class="panel">
            <div class="form-grid">
              <label class="wide">Website URL<input id="url" name="url" type="text" placeholder="http://localhost:3000" required autocomplete="url" spellcheck="false" /><small>Local and private websites are reached from the machine running Telescope.</small></label>
              <label>Browser<select id="browser" name="browser"><option value="chrome">Chrome</option><option value="chromium">Chromium</option><option value="firefox">Firefox</option><option value="safari">WebKit</option><option value="edge">Edge</option><option value="chrome-beta">Chrome Beta</option><option value="canary">Chrome Canary</option></select></label>
              <label>Device<input id="device" name="device" placeholder="Optional Playwright device name" /></label>
              <label class="wide">Registered script<select id="registered-script"><option value="">Single-page navigation</option></select><small id="script-help">Set TELESCOPE_SCRIPTS_DIR on the server to provision trusted scripts.</small></label>
              <label>Viewport width<input id="width" name="width" type="number" min="1" step="1" placeholder="Browser default" /></label>
              <label>Viewport height<input id="height" name="height" type="number" min="1" step="1" placeholder="Browser default" /></label>
              <label>Timeout (milliseconds)<input id="timeout" name="timeout" type="number" min="1" step="1" placeholder="30000" /></label>
              <label>Network profile<select id="connectionType" name="connectionType"><option value="">No throttling</option><option value="fios">FIOS</option><option value="cable">Cable</option><option value="dsl">DSL</option><option value="4g">4G</option><option value="3gfast">3G fast</option><option value="3g">3G</option><option value="3gslow">3G slow</option><option value="2g">2G</option></select></label>
            </div>
            <details><summary>Advanced options</summary><div class="form-grid"><label class="wide">Additional options (JSON)<textarea id="advanced" spellcheck="false" placeholder='{"headers": {"x-environment": "development"}, "block": ["analytics"]}'></textarea><small>Use Telescope option names. Managed output and upload options are controlled by the workspace.</small></label></div></details>
            <details id="save-details"><summary>Save this configuration</summary><div class="form-grid"><label class="wide">Test name<input id="definition-name" maxlength="160" placeholder="Homepage baseline" /></label><label class="wide">Description<input id="definition-description" maxlength="1000" placeholder="Optional notes" /></label></div><p class="help">Credentials, cookies, and sensitive headers are omitted from reusable definitions. Supply them again when needed.</p><div class="actions" style="margin-top:14px"><button id="save-definition" class="button" type="button">Save configuration</button><button id="clear-definition" class="button" type="button" hidden>Save as a new test</button></div></details>
            <div class="actions form-actions"><span class="help" id="form-context">A new result is saved for every run.</span><button id="run-submit" class="button primary" type="submit">Run test →</button></div>
          </form>
          <aside class="panel" aria-labelledby="jobs-title"><div class="job-top" style="margin-bottom:18px"><h2 id="jobs-title" style="margin:0">Run activity</h2><button id="refresh-jobs" class="button small" type="button">Refresh</button></div><div id="jobs" aria-live="polite"><div class="empty">Loading activity…</div></div></aside>
        </div>
      </section>
      <section id="page-history" aria-labelledby="history-title" hidden>
        <p id="forward-disclosure" class="notice" hidden></p>
        <div class="page-head"><div><h1 id="history-title">Your results</h1><p class="muted">Saved captures stay available after Telescope restarts.</p></div><div class="actions"><label class="button" for="import-file">Import ZIP<input id="import-file" type="file" accept=".zip,application/zip" class="sr-only" /></label><button id="refresh-results" class="button" type="button">Refresh results</button></div></div>
        <div class="toolbar"><label class="sr-only" for="result-search">Search results</label><input id="result-search" type="search" placeholder="Search name, URL, browser or test ID" /><label class="sr-only" for="result-status">Filter by status</label><select id="result-status"><option value="">All statuses</option><option value="passed">Passed</option><option value="failed">Failed</option><option value="cancelled">Cancelled</option><option value="interrupted">Interrupted</option><option value="running">Running</option><option value="legacy">Legacy / unknown</option></select><span id="result-count" class="count"></span></div>
        <div id="result-list" class="result-list"></div><div id="pagination" class="pagination" hidden></div>
      </section>
      <section id="page-saved" aria-labelledby="saved-title" hidden>
        <div class="page-head"><div><h1 id="saved-title">Saved tests</h1><p class="muted">Reusable configurations, with a fresh capture on every run.</p></div><button id="new-definition" class="button primary" type="button">New configuration</button></div><div id="definition-list" class="definition-list"></div>
      </section>
      <section id="page-forwarding" aria-labelledby="forwarding-title" hidden>
        <div class="page-head"><div><h1 id="forwarding-title">ZIP forwarding</h1><p class="muted">Forwarding sends an additional copy of accepted ZIP imports. Saved results remain in this workspace.</p></div><div class="actions"><button id="forward-refresh" class="button" type="button">Refresh</button><button id="forward-process" class="button" type="button">Process due delivery</button></div></div>
        <p id="forward-status" class="notice"></p><div id="forward-deliveries" class="stack"></div>
      </section>
      <section id="page-result" aria-labelledby="result-title" hidden>
        <div class="breadcrumbs"><a href="#history">← All results</a></div><div id="result-detail"></div>
      </section>
      <footer>Results and reusable configurations are stored by this local workspace. Target websites may require internet access.</footer>
    </main>
    <script>
      (() => {
        'use strict';
        const $ = selector => document.querySelector(selector);
        const state = { token: '', authenticated: false, scripts: [], scriptHash: '', results: [], definitions: [], jobs: [], page: 'run', resultPage: 1, definitionId: null, requestId: null, loadingJobs: false, currentResult: null, renderGeneration: 0 };
        const fragmentToken = location.hash.startsWith('#token=') ? new URLSearchParams(location.hash.slice(1)).get('token') : null;
        try { state.token = fragmentToken || sessionStorage.getItem('telescope-session') || ''; } catch { state.token = fragmentToken || ''; }
        if (fragmentToken) history.replaceState(null, '', location.pathname + location.search + '#run');
        const activeStatuses = new Set(['queued', 'claimed', 'running', 'finalizing']);
        const form = $('#run-form');
        const node = (tag, className, text) => { const value = document.createElement(tag); if (className) value.className = className; if (text !== undefined && text !== null) value.textContent = String(text); return value; };
        const action = (label, handler, className = '') => { const value = node('button', 'button ' + className, label); value.type = 'button'; value.addEventListener('click', () => Promise.resolve().then(handler).catch(showError)); return value; };
        const link = (label, href, className = 'button') => { const value = node('a', className, label); const raw = String(href || ''); try { const target = new URL(raw, location.origin); if (!['http:', 'https:'].includes(target.protocol)) throw new Error('Unsupported link'); if (!raw.startsWith('#') && !raw.startsWith('/') && target.origin !== location.origin) { value.rel = 'noopener noreferrer'; } value.href = target.href; } catch { value.removeAttribute('href'); value.setAttribute('aria-disabled', 'true'); } return value; };
        const statusBadge = status => node('span', 'status ' + String(status || 'legacy').replace(/[^a-z-]/g, ''), status || 'Legacy / unknown');
        const text = value => value === undefined || value === null || value === '' ? 'Unavailable' : String(value);
        const numeric = value => typeof value === 'number' && Number.isFinite(value) ? value : undefined;
        const ms = value => numeric(value) === undefined ? 'Unavailable' : value >= 1000 ? (value / 1000).toFixed(2) + ' s' : Math.round(value) + ' ms';
        const bytes = value => numeric(value) === undefined ? 'Unavailable' : value >= 1048576 ? (value / 1048576).toFixed(2) + ' MB' : value >= 1024 ? (value / 1024).toFixed(1) + ' KB' : value + ' B';
        const date = value => { const parsed = new Date(value); return Number.isNaN(parsed.getTime()) ? 'Date unavailable' : parsed.toLocaleString(); };
        const artifact = (id, path) => '/api/local/artifacts/' + encodeURIComponent(id) + '/' + String(path).split('/').map(encodeURIComponent).join('/');
        function notice(message, kind = '') { const target = $('#notice'); target.textContent = message; target.className = 'notice ' + kind; target.hidden = !message; }
        function showError(error) { notice(error instanceof Error ? error.message : String(error), 'error'); }
        async function api(path, options = {}) { const headers = new Headers(options.headers || {}); if (state.token) headers.set('X-Telescope-Token', state.token); let body = options.body; if (body && !(body instanceof FormData)) { headers.set('Content-Type', 'application/json'); body = JSON.stringify(body); } const response = await fetch('/api/local' + path, { ...options, body, headers, credentials: 'same-origin' }); const type = response.headers.get('content-type') || ''; const result = type.includes('json') ? await response.json() : { error: await response.text() }; if (!response.ok) throw new Error(result.error || result.message || 'Request failed (' + response.status + ')'); return result; }
        function showPage(page) { state.page = page; for (const name of ['run', 'history', 'saved', 'result', 'forwarding']) $('#page-' + name).hidden = name !== page; document.querySelectorAll('nav button').forEach(button => { if (button.dataset.page === page || page === 'result' && button.dataset.page === 'history') button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current'); }); }
        function go(page) { if (location.hash.slice(1) === page) route().catch(showError); else location.hash = page; }
        async function route() { const raw = location.hash.slice(1) || 'run'; const match = raw.match(/^result\/([^?]+)(?:\?(.*))?$/); if (match) { showPage('result'); await loadResult(decodeURIComponent(match[1]), new URLSearchParams(match[2] || '').get('step')); return; } const page = ['run', 'history', 'saved', 'forwarding'].includes(raw) ? raw : 'run'; showPage(page); if (page === 'history') await loadResults(); if (page === 'saved') await loadDefinitions(); if (page === 'forwarding') await loadForwarding(); }
