        function renderWaterfall(har) { const entries = Array.isArray(har?.log?.entries) ? har.log.entries : []; if (!entries.length) return emptyPanel('No recorded requests are available.'); const starts = entries.map(value => Date.parse(value.startedDateTime)).filter(Number.isFinite); const first = starts.length ? Math.min(...starts) : 0; const end = Math.max(1, ...entries.map(value => Math.max(0, (Date.parse(value.startedDateTime) || first) - first) + Math.max(0, value.time || 0))); const root = node('div'); root.append(node('p', 'table-caption', entries.length + ' requests · ' + ms(end) + ' recorded window. Bars include complete request duration.')); root.append(table(['Request', 'Status', 'Transferred', 'Duration', 'Timeline'], entries.map(entry => { const request = entry.request || {}; const response = entry.response || {}; const label = node('div'); label.append(node('div', '', request.method || 'GET'), node('div', 'muted', request.url || 'Unknown request')); const track = node('div', 'wf-track'); const bar = node('span', 'wf-bar' + (response.status >= 400 ? ' failed' : '')); const start = Math.max(0, (Date.parse(entry.startedDateTime) || first) - first); bar.style.left = (100 * start / end).toFixed(3) + '%'; bar.style.width = Math.max(.2, 100 * Math.max(0, entry.time || 0) / end).toFixed(3) + '%'; track.title = 'Started ' + ms(start) + ' · duration ' + ms(entry.time); track.append(bar); return [label, response.status ?? 'Unavailable', bytes(response._transferSize ?? response.bodySize ?? response.content?.size), ms(entry.time), track]; }), { caption: 'Recorded network waterfall' })); return root; }
        function renderResources(resources) { const values = Array.isArray(resources) ? resources : []; if (!values.length) return emptyPanel('No Resource Timing entries are available.'); return table(['Resource', 'Type', 'Start', 'Duration', 'Transferred', 'Decoded'], values.map(value => [value.name, value.initiatorType || value.entryType, ms(value.startTime), ms(value.duration), bytes(value.transferSize), bytes(value.decodedBodySize)]), { caption: 'Captured resource timing entries' }); }
        function renderConsole(messages) { const values = Array.isArray(messages) ? messages : []; if (!values.length) return emptyPanel('No console messages were captured.'); const root = node('div'); for (const message of values) { const type = String(message.type || 'log'); const row = node('div', 'console-row ' + type.replace(/[^a-z]/g, '')); const content = node('div'); content.append(node('div', 'console-text', message.text ?? message.message ?? '')); if (message.location?.url) content.append(node('div', 'console-source', message.location.url + ':' + (message.location.lineNumber || 0))); row.append(node('span', 'muted', type), content); root.append(row); } return root; }
        function renderMedia(id, paths, config, activeStep, sessionVideo) {
          const root = node('div');
          const safePath = value => typeof value === 'string' && value.length > 0 && !/[\\\0:]/.test(value) && value.split('/').every(part => part && part !== '.' && part !== '..' && !part.startsWith('.'));
          const appendVideo = (title, videoPath, note) => {
            const content = node('div');
            if (note) content.append(node('p', 'help', note));
            const video = node('video'); video.controls = true; video.preload = 'metadata'; video.src = artifact(id, videoPath);
            video.addEventListener('error', () => { video.replaceWith(emptyPanel('This recording is unavailable.')); }, { once: true });
            content.append(video);
            const download = link('Download recording', artifact(id, videoPath), 'button small'); download.download = videoPath.split('/').pop(); content.append(download);
            root.append(subsection(title, content));
          };
          const appendFrames = (frames, title, stepRelative) => {
            if (!frames.length) { root.append(subsection(title, emptyPanel('No filmstrip frames are available for this capture.'))); return; }
            const strip = node('div', 'filmstrip');
            frames.forEach((frame, index) => {
              const figure = node('figure', 'frame'); const anchor = link('', artifact(id, frame.path), ''); anchor.target = '_blank'; anchor.rel = 'noopener';
              const img = node('img'); img.src = artifact(id, frame.path); img.loading = 'lazy';
              const caption = (stepRelative ? 'Step +' : '') + ms(frame.ms); img.alt = stepRelative ? 'Step frame at +' + ms(frame.ms) : 'Filmstrip frame ' + (index + 1);
              img.addEventListener('error', () => { figure.replaceChildren(node('figcaption', '', caption + ' · image unavailable')); }, { once: true });
              anchor.append(img); figure.append(anchor, node('figcaption', '', caption)); strip.append(figure);
            });
            root.append(subsection(title, strip));
          };
          if (activeStep) {
            const media = activeStep.media;
            const base = typeof activeStep.artifactBase === 'string' ? activeStep.artifactBase.replace(/\/$/, '') + '/' : '';
            const scopedPath = value => Boolean(base && safePath(value) && value.startsWith(base) && paths.includes(value));
            if (media?.status === 'available') {
              const frames = (Array.isArray(media.frames) ? media.frames : []).filter(frame => frame && scopedPath(frame.path) && /\.(?:jpe?g|png)$/i.test(frame.path) && numeric(frame.ms) !== undefined && frame.ms >= 0).sort((a, b) => a.ms - b.ms);
              appendFrames(frames, 'Step filmstrip', true);
              if (media.alignment?.method === 'color-calibration' && numeric(media.alignment.uncertaintyMs) !== undefined && media.alignment.uncertaintyMs >= 0) root.append(node('p', 'help', 'Color-calibrated step media · timing uncertainty ±' + ms(media.alignment.uncertaintyMs) + '. Frame labels use the explicit step-relative capture timestamps.'));
              if (scopedPath(media.videoPath) && /\.webm$/i.test(media.videoPath)) appendVideo('Step recording', media.videoPath, 'This recording is cropped to the selected step.');
              else root.append(subsection('Step recording', emptyPanel(media.reason || 'No recording is available for this step.')));
            } else {
              root.append(subsection('Step media', emptyPanel(media?.reason || 'Media is unavailable for this step because no validated recording alignment was captured.')));
            }
            if (safePath(sessionVideo?.path) && /\.webm$/i.test(sessionVideo.path) && !sessionVideo.path.startsWith('steps/')) appendVideo('Full-session recording', sessionVideo.path, 'Includes setup and the complete journey. Playback uses the recording clock, independently of the selected step.');
            return root;
          }
          const frameRate = numeric(config?.options?.frameRate) || 1;
          const frames = paths.filter(value => safePath(value) && /^filmstrip\/[^/]+\.(?:jpe?g|png)$/i.test(value)).sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).map((framePath, index) => ({ path: framePath, ms: index * 1000 / frameRate }));
          appendFrames(frames, 'Filmstrip', false);
          const videoPath = paths.find(value => safePath(value) && !value.includes('/') && /\.webm$/i.test(value));
          if (videoPath) appendVideo('Video', videoPath);
          else root.append(subsection('Video', emptyPanel('No video recording is available.')));
          return root;
        }
        function renderConfig(id, config, info, base, paths) { const root = node('div'); const values = config?.options || {}; const rows = [['Test ID', id], ['URL', config?.url || info.url], ['Browser', values.browser || info.browser], ['Device', values.deviceName || (typeof values.device === 'string' ? values.device : values.device?.name)], ['Viewport', [values.width, values.height].filter(Boolean).join(' × ') || 'Browser default'], ['Timeout', ms(values.timeout)], ['Network profile', values.connectionType || 'No throttling'], ['Frame rate', numeric(values.frameRate) === undefined ? 'Default' : values.frameRate + ' fps'], ['JavaScript', values.disableJS ? 'Disabled' : 'Enabled'], ['Captured', date(config?.date || info.date)]]; const kv = node('dl', 'kv'); rows.forEach(([label, value]) => kv.append(node('dt', '', label), node('dd', '', text(value)))); root.append(kv); root.append(node('p', 'help', 'Credential values and raw request headers are omitted from this preview. Downloaded capture files may contain sensitive data.')); const downloads = node('div', 'actions'); downloads.style.marginTop = '20px'; for (const [path, label] of [[base + 'pageload.har', 'Download HAR'], [base + 'metrics.json', 'Metrics JSON'], [base + 'resources.json', 'Resource timings'], [base + 'console.json', 'Console JSON']]) if (paths.includes(path)) { const value = link(label, artifact(id, path)); value.download = path.split('/').pop(); downloads.append(value); } if (downloads.childNodes.length) root.append(downloads); return root; }
        document.querySelectorAll('nav button[data-page]').forEach(button => button.addEventListener('click', () => go(button.dataset.page)));
        $('#refresh-jobs').addEventListener('click', () => loadJobs().catch(showError));
        $('#refresh-results').addEventListener('click', () => loadResults().then(() => notice('Results refreshed.', 'success')).catch(showError));
        for (const name of ['result-search', 'result-status']) $('#' + name).addEventListener(name === 'result-search' ? 'input' : 'change', () => { state.resultPage = 1; renderResults(); });
        $('#import-file').addEventListener('change', async event => { const file = event.target.files?.[0]; if (!file) return; const data = new FormData(); data.append('file', file); notice('Importing ' + file.name + '…'); try { const result = await api('/import', { method: 'POST', body: data }); await loadResults(); const id = result.testId || result.result?.testId || result.summary?.testId; notice(result.duplicate ? 'This capture is already in your library.' : 'Result imported.', 'success'); if (id) go('result/' + encodeURIComponent(id)); else go('history'); } catch (error) { showError(error); } finally { event.target.value = ''; } });
        async function openSession() { const session = await api('/session'); if (session.requiresToken) { state.authenticated = false; for (const name of ['run', 'history', 'saved', 'result', 'forwarding']) $('#page-' + name).hidden = true; $('#session-gate').hidden = false; $('#session-token').focus(); return; } if (session.token) state.token = session.token; await api('/session', { method: 'POST' }); state.authenticated = true; $('#session-gate').hidden = true; try { sessionStorage.setItem('telescope-session', state.token); } catch {} await Promise.all([loadJobs(), loadResults(), loadDefinitions(), loadScripts(), loadForwardingStatus()]); await route(); }
        $('#session-form').addEventListener('submit', async event => { event.preventDefault(); state.token = $('#session-token').value.trim(); try { await openSession(); if (state.authenticated) { $('#session-token').value = ''; notice(''); } } catch (error) { showError(error); } });
        window.addEventListener('hashchange', () => { if (state.authenticated) route().catch(showError); });
        document.addEventListener('visibilitychange', () => { if (state.authenticated && !document.hidden) loadJobs().catch(showError); });
        setInterval(() => { if (state.authenticated && !document.hidden) loadJobs().catch(() => {}); }, 1800);
        openSession().catch(error => { for (const name of ['run', 'history', 'saved', 'result', 'forwarding']) $('#page-' + name).hidden = true; $('#session-gate').hidden = false; $('#session-token').focus(); showError(error); });
      })();
    </script>
