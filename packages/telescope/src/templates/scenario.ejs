<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= scenario.name || 'Telescope journey' %></title>
    <style>
      :root { color-scheme: light dark; --bg:#f6f6f4; --surface:#fff; --text:#222621; --muted:#687068; --line:#dce0d8; --accent:#bd4c10; --good:#2b744d; --bad:#ba3939; }
      @media (prefers-color-scheme: dark) { :root { --bg:#151815; --surface:#1d211d; --text:#e6eae4; --muted:#abb4a8; --line:#343c33; --accent:#ff984f; --good:#81d0a0; --bad:#ff9696; } }
      * { box-sizing:border-box; } body { margin:0; background:var(--bg); color:var(--text); font:14px/1.6 system-ui,sans-serif; }
      header { border-bottom:1px solid var(--line); background:var(--surface); padding:16px 30px; display:flex; justify-content:space-between; gap:20px; } header strong { letter-spacing:-.5px; }
      main { max-width:1380px; margin:0 auto; padding:32px 26px 60px; } h1 { font-size:29px; line-height:1.2; letter-spacing:-1px; margin:0 0 10px; } h2 { font-size:19px; margin:0 0 16px; } p { margin:0 0 16px; } a { color:var(--accent); }
      .muted { color:var(--muted); } .status { border:1px solid var(--line); border-radius:25px; padding:3px 10px; font-size:11px; text-transform:capitalize; display:inline-block; } .passed { color:var(--good); } .failed,.cancelled { color:var(--bad); }
      .panel { background:var(--surface); border:1px solid var(--line); border-radius:11px; padding:22px; margin-top:22px; } .notice { border-left:3px solid var(--accent); padding:13px 16px; background:var(--surface); margin:16px 0; overflow-wrap:anywhere; } .notice.error { border-color:var(--bad); color:var(--bad); }
      .steps { display:flex; gap:10px; flex-wrap:wrap; margin:24px 0; } button { font:inherit; cursor:pointer; color:var(--text); background:var(--surface); border:1px solid var(--line); border-radius:7px; padding:9px 13px; } .step { max-width:300px; text-align:left; } .step[aria-pressed="true"] { border-color:var(--accent); color:var(--accent); } .step .status { margin-left:7px; }
      .overview { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(220px,.8fr); gap:20px; margin-top:20px; } .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; } .card { padding:17px; border:1px solid var(--line); border-radius:9px; background:var(--surface); } .card label { display:block; font-size:11px; color:var(--muted); } .card strong { display:block; font-size:23px; line-height:1.8; font-variant-numeric:tabular-nums; letter-spacing:-.6px; overflow-wrap:anywhere; }
      .screenshot { margin:0; display:grid; place-items:center; padding:0; min-height:180px; overflow:hidden; } .screenshot img { width:100%; max-height:340px; object-fit:contain; } .empty { color:var(--muted); padding:24px; text-align:center; }
      .tabs { display:flex; gap:6px; flex-wrap:wrap; margin:24px 0 0; border-bottom:1px solid var(--line); } .tabs button { border:0; border-bottom:2px solid transparent; border-radius:0; color:var(--muted); background:transparent; } .tabs button[aria-selected="true"] { border-color:var(--accent); color:var(--accent); }
      .scroll { overflow:auto; max-height:640px; } table { width:100%; border-collapse:collapse; font-size:12px; font-variant-numeric:tabular-nums; } th,td { padding:10px 12px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; } th { color:var(--muted); position:sticky; top:0; background:var(--surface); font-weight:600; } td.url { max-width:430px; overflow-wrap:anywhere; } td.number { text-align:right; white-space:nowrap; }
      .track { position:relative; height:15px; min-width:220px; background:var(--bg); border-radius:3px; } .bar { position:absolute; height:11px; top:2px; background:var(--accent); border-radius:2px; min-width:2px; } pre { margin:0; font:12px/1.7 ui-monospace,SFMono-Regular,Consolas,monospace; overflow:auto; max-height:640px; white-space:pre-wrap; overflow-wrap:anywhere; } .console-entry { border-bottom:1px solid var(--line); padding:10px 0; } .console-entry pre { max-height:none; } .console-entry.error { color:var(--bad); } .downloads { display:flex; flex-wrap:wrap; gap:16px; margin:15px 0; font-size:12px; } video { width:100%; max-height:520px; background:#000; border-radius:7px; } footer { color:var(--muted); margin-top:24px; font-size:11px; }
      @media (max-width:800px) { main { padding:24px 16px; } header { padding:14px 16px; } .overview { grid-template-columns:1fr; } .cards { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    </style>
  </head>
  <body>
    <header><strong>Telescope</strong><span class="muted">Multi-step performance report</span></header>
    <main>
      <h1><%= scenario.name || 'Browser journey' %></h1>
      <p class="muted">One browser session · <%= scenario.steps.length %> steps · <%= Math.round(scenario.durationMs) %>ms</p>
      <span class="status <%= scenario.status %>"><%= scenario.status %></span>
      <% if (scenario.error) { %><div class="notice error"><%= scenario.error %></div><% } %>
      <nav id="steps" class="steps" aria-label="Journey steps"></nav>
      <section aria-labelledby="step-title">
        <h2 id="step-title"></h2><p id="step-meta" class="muted"></p><div id="step-error" hidden class="notice error"></div>
        <div class="overview"><div id="cards" class="cards"></div><div id="screenshot" class="panel screenshot"></div></div>
        <div id="tabs" class="tabs" role="tablist" aria-label="Step diagnostics"></div>
        <div id="diagnostics" class="panel" role="tabpanel" tabindex="0"></div>
      </section>
      <footer>Navigation metrics are observed through the capture boundary. Interaction steps contain interval diagnostics. Journey metrics are not aggregate Core Web Vitals.</footer>
    </main>
    <script id="report-data" type="application/json"><%- payload %></script>
    <script>
      (() => {
        const data = JSON.parse(document.getElementById('report-data').textContent);
        const $ = id => document.getElementById(id);
        const element = (tag, text, className) => { const value = document.createElement(tag); if (text !== undefined) value.textContent = text; if (className) value.className = className; return value; };
        const finite = value => typeof value === 'number' && Number.isFinite(value);
        const ms = value => finite(value) ? (value < 1000 ? value.toFixed(1) + 'ms' : (value / 1000).toFixed(2) + 's') : 'Unavailable';
        const bytes = value => finite(value) ? value < 1024 ? value + ' B' : (value / 1024).toFixed(1) + ' KB' : 'Unavailable';
        const json = value => value === null || value === undefined ? empty('This diagnostic was not captured.') : element('pre', JSON.stringify(value, null, 2));
        const empty = text => element('div', text, 'empty');
        let selected = null, activeTab = 'metrics';
        const table = (headings, rows) => { if (!rows.length) return empty('No entries were captured for this step.'); const scroll = element('div', undefined, 'scroll'); const value = element('table'); const head = element('thead'), heading = element('tr'); headings.forEach(text => heading.append(element('th', text))); head.append(heading); const body = element('tbody'); rows.forEach(cells => { const row = element('tr'); cells.forEach((cell, index) => { const td = element('td', undefined, index === 0 ? 'url' : ''); if (cell instanceof Node) td.append(cell); else td.textContent = cell === null || cell === undefined ? 'Unavailable' : String(cell); row.append(td); }); body.append(row); }); value.append(head, body); scroll.append(value); return scroll; };
        const download = (label, relative) => { const link = element('a', label); link.href = relative.split('/').map(encodeURIComponent).join('/'); link.download = ''; return link; };
        const renderNetwork = () => { const entries = selected.har?.log?.entries || []; const max = Math.max(selected.durationMs || 0, 1, ...entries.map(value => Math.max(0, value._stepStartOffsetMs || 0) + Math.max(0, value.time || 0))); const root = element('div'); root.append(element('p', 'Requests belong to the step in which they started; late completions can extend beyond its action duration.', 'muted')); root.append(table(['Request', 'Status', 'Type', 'Start', 'Duration', 'Timeline'], entries.map(value => { const start = Math.max(0, value._stepStartOffsetMs || 0), duration = Math.max(0, value.time || 0); const track = element('div', undefined, 'track'), bar = element('span', undefined, 'bar'); bar.style.left = Math.min(100, start / max * 100) + '%'; bar.style.width = Math.max(.3, Math.min(100 - start / max * 100, duration / max * 100)) + '%'; track.append(bar); return [value.request?.url, value.response?.status, value._resourceType, ms(start), ms(duration), track]; }))); return root; };
        const renderResources = () => table(['Resource', 'Initiator', 'Duration', 'Transfer size'], (selected.resources || []).map(value => [value.name, value.initiatorType, ms(value.duration), bytes(value.transferSize)]));
        const renderConsole = () => { const root = element('div'), messages = selected.console || []; if (!messages.length) return empty('No console messages were captured for this step.'); messages.forEach(value => { const row = element('div', undefined, 'console-entry ' + (value.type === 'error' ? 'error' : '')); row.append(element('small', value.type || 'log', 'muted'), element('pre', value.text || '')); const location = value.location || {}; if (location.url) row.append(element('small', location.url + ':' + (location.lineNumber || 0), 'muted')); root.append(row); }); return root; };
        const renderMedia = () => { const root = element('div'); root.append(element('p', 'Step video and filmstrip alignment is unavailable. No step-specific recording offsets are inferred.', 'muted')); if (data.sessionVideo) { root.append(element('h2', 'Full session recording')); const video = element('video'); video.controls = true; video.preload = 'metadata'; video.src = encodeURIComponent(data.sessionVideo); root.append(video); } else root.append(empty('No session recording is available.')); return root; };
        const views = [['metrics', 'All metrics', () => json(selected.metrics)], ['network', 'Waterfall', renderNetwork], ['resources', 'Resources', renderResources], ['console', 'Console', renderConsole], ['media', 'Recording', renderMedia]];
        const chooseTab = name => { activeTab = name; $('diagnostics').replaceChildren(views.find(value => value[0] === name)[2]()); $('diagnostics').setAttribute('aria-labelledby', 'tab-' + name); document.querySelectorAll('#tabs button').forEach(button => { const active = button.dataset.name === name; button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1; }); };
        views.forEach(([name, label], index) => { const button = element('button', label); button.type = 'button'; button.id = 'tab-' + name; button.dataset.name = name; button.setAttribute('role', 'tab'); button.setAttribute('aria-controls', 'diagnostics'); button.addEventListener('click', () => chooseTab(name)); button.addEventListener('keydown', event => { if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return; event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? views.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + views.length) % views.length; chooseTab(views[next][0]); $('tab-' + views[next][0]).focus(); }); $('tabs').append(button); });
        const select = () => {
          const id = new URLSearchParams(location.hash.slice(1)).get('step'); selected = data.steps.find(step => step.id === id) || data.steps.find(step => step.status === 'failed' || step.status === 'cancelled') || data.steps[0];
          $('step-title').textContent = (selected.order + 1) + '. ' + selected.name; $('step-meta').textContent = [selected.kind, selected.status, selected.endingUrl || selected.startingUrl || 'Not executed'].join(' · '); $('step-error').hidden = !selected.error; $('step-error').textContent = selected.error || '';
          document.querySelectorAll('#steps button').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.id === selected.id)));
          const metrics = selected.metrics || {}, interval = selected.kind === 'interaction', nav = metrics.navigationTiming, paints = metrics.paintTiming || [], lcp = metrics.largestContentfulPaint?.at(-1); const cards = [['Action duration', ms(selected.durationMs)], ['Time to first byte', interval ? 'Not applicable' : ms(nav ? nav.responseStart - (nav.fetchStart || 0) : undefined)], ['First contentful paint', interval ? 'Not applicable' : ms(paints.find(value => value.name === 'first-contentful-paint')?.startTime)], ['Largest contentful paint', interval ? 'Not applicable' : ms(lcp?.renderTime || lcp?.startTime)], ['Requests started', finite(metrics.requests?.count) ? String(metrics.requests.count) : 'Unavailable'], ['Transferred', bytes(metrics.requests?.transferBytes)]];
          $('cards').replaceChildren(...cards.map(([label, value]) => { const card = element('div', undefined, 'card'); card.append(element('label', label), element('strong', value)); return card; }));
          const screenshot = $('screenshot'); screenshot.replaceChildren(); if (selected.screenshot) { const image = element('img'); image.src = selected.screenshot.split('/').map(encodeURIComponent).join('/'); image.alt = 'Screenshot of ' + selected.name; image.addEventListener('error', () => screenshot.replaceChildren(empty('Screenshot unavailable.')), { once:true }); screenshot.append(image); } else screenshot.append(empty(selected.status === 'skipped' ? 'This step was skipped.' : 'Screenshot unavailable.'));
          chooseTab(activeTab); const links = element('div', undefined, 'downloads'); links.append(download('Run configuration', 'config.json')); if (selected.metrics) links.append(download('Step metrics', selected.artifactBase + '/metrics.json')); if (selected.har) links.append(download('Step HAR', selected.artifactBase + '/pageload.har')); $('diagnostics').append(links);
        };
        data.steps.forEach((step, index) => { const button = element('button', (index + 1) + '. ' + step.name, 'step'); button.type = 'button'; button.dataset.id = step.id; const badge = element('span', step.status, 'status ' + step.status); button.append(badge); button.addEventListener('click', () => { location.hash = 'step=' + encodeURIComponent(step.id); }); $('steps').append(button); });
        addEventListener('hashchange', select); select();
      })();
    </script>
  </body>
</html>
