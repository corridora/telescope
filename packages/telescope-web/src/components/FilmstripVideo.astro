---
import { createResultStore } from '@/lib/storage/resultStore';
import type { MetricsJson } from '@/lib/types/metrics';
import type { ScenarioStepResult } from '@cloudflare/telescope/contracts';
interface Props {
  testId: string;
  metrics: MetricsJson | null;
  artifactBase?: string;
  step?: ScenarioStepResult;
  fullSessionVideo?: string;
}
const {
  testId,
  metrics,
  artifactBase = '',
  step,
  fullSessionVideo,
} = Astro.props;
const store = createResultStore();
const stepMedia = step?.media;
const scoped = Boolean(artifactBase);
let frameRate = 1;
try {
  if (!scoped) {
    const configObj = await store.get(testId, 'config.json');
    if (configObj) {
      const config = await configObj.json<{
        options?: { frameRate?: number };
      }>();
      frameRate = config?.options?.frameRate || 1;
    }
  }
} catch (error) {
  console.error('Error reading config.json:', error);
}
const fcpMs = metrics?.paintTiming?.find(
  p => p.name === 'first-contentful-paint',
)?.startTime;
const lcpEntry = metrics?.largestContentfulPaint?.at(-1);
const lcpMs =
  lcpEntry?.renderTime && lcpEntry.renderTime > 0
    ? lcpEntry.renderTime
    : lcpEntry?.startTime;
const layoutShifts =
  metrics?.layoutShifts?.filter(s => !s.hadRecentInput) || [];
interface FilmstripFrame {
  filename: string;
  frameNum: number;
  url: string;
  ms: number;
  timeLabel: string;
  isFcp: boolean;
  isLcp: boolean;
  hasShift: boolean;
}
let filmstripFrames: FilmstripFrame[] = [];
let videoUrl: string | null = null;
let sessionVideoUrl: string | null = null;
const unavailableReason =
  scoped && stepMedia?.status !== 'available'
    ? stepMedia?.reason || 'Aligned media is unavailable for this step.'
    : null;
try {
  const names = await store.list(testId);
  const available = new Set(names);
  const framePrefix = `${artifactBase}filmstrip/`;
  const frames = scoped
    ? (stepMedia?.status === 'available' ? (stepMedia.frames ?? []) : [])
        .filter(
          frame =>
            frame.path.startsWith(framePrefix) && available.has(frame.path),
        )
        .map((frame, index) => ({
          filename: frame.path.slice(framePrefix.length),
          frameNum: index + 1,
          url: `/api/tests/${testId}/${frame.path}`,
          ms: frame.ms,
        }))
    : names
        .filter(
          name =>
            name.startsWith(framePrefix) &&
            !name.slice(framePrefix.length).includes('/') &&
            /\.(jpg|png)$/.test(name),
        )
        .map(name => {
          const filename = name.slice(framePrefix.length);
          const match = filename.match(/(\d+)\.(?:jpg|png)$/);
          const frameNum = match ? Number.parseInt(match[1], 10) : 0;
          return {
            filename,
            frameNum,
            url: `/api/tests/${testId}/${name}`,
            ms: Math.max(0, Math.floor(((frameNum - 1) * 1000) / frameRate)),
          };
        })
        .sort((a, b) => a.frameNum - b.frameNum);
  filmstripFrames = frames.map(frame => {
    const ms = frame.ms;
    const timeLabel = ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`;
    const tolerance = 1000 / frameRate / 2;
    return {
      ...frame,
      ms,
      timeLabel,
      isFcp: !scoped && fcpMs !== undefined && Math.abs(ms - fcpMs) < tolerance,
      isLcp: !scoped && lcpMs !== undefined && Math.abs(ms - lcpMs) < tolerance,
      hasShift:
        !scoped &&
        layoutShifts.some(shift => Math.abs(ms - shift.startTime) < tolerance),
    };
  });
  const video = scoped
    ? stepMedia?.status === 'available' &&
      stepMedia.videoPath?.startsWith(artifactBase) &&
      available.has(stepMedia.videoPath)
      ? stepMedia.videoPath
      : undefined
    : names.find(name => !name.includes('/') && name.endsWith('.webm'));
  if (video) videoUrl = `/api/tests/${testId}/${video}`;
  if (
    scoped &&
    fullSessionVideo &&
    !fullSessionVideo.includes('/') &&
    fullSessionVideo.endsWith('.webm') &&
    available.has(fullSessionVideo)
  ) {
    sessionVideoUrl = `/api/tests/${testId}/${fullSessionVideo}`;
  }
} catch (error) {
  console.error('Error loading filmstrip/video:', error);
}
---

<div class="filmstrip-video-container">
  {unavailableReason && <p class="empty-state">{unavailableReason}</p>}
  {scoped && stepMedia?.status === 'available' && stepMedia.alignment &&
    <p>Frame times are relative to this step. Alignment uncertainty: ±{Math.ceil(stepMedia.alignment.uncertaintyMs)}ms.</p>}
  <section class="filmstrip-section">
    <h3>Filmstrip Timeline</h3>
    <div class="filmstrip-timeline">
      {
        filmstripFrames.length > 0 ? (
          filmstripFrames.map(frame => (
            <div class="frame-wrapper">
              <img
                src={frame.url}
                alt={`Frame at ${frame.ms}ms`}
                loading="eager"
                class:list={[
                  'frame-image',
                  { fcp: frame.isFcp, lcp: frame.isLcp, shift: frame.hasShift },
                ]}
              />
              <span class="frame-timestamp">{frame.timeLabel}</span>
              {frame.isFcp && <span class="frame-label fcp">FCP</span>}
              {frame.isLcp && <span class="frame-label lcp">LCP</span>}
              {frame.hasShift && <span class="frame-label shift">Shift</span>}
            </div>
          ))
        ) : (
          <div class="empty-state">
            No filmstrip frames available for this test.
          </div>
        )
      }
    </div>
  </section>
  <section class="video-section">
    <h3>{scoped ? 'Step Recording' : 'Page Load Recording'}</h3>
    {
      videoUrl ? (
        <div class="video-container">
          <video src={videoUrl} controls preload="metadata" />
        </div>
      ) : (
        <div class="empty-state">
          No video recording available for this test.
        </div>
      )
    }
  </section>
  {sessionVideoUrl && <section class="video-section">
    <h3>Full-session Recording</h3>
    <p>Includes setup and all steps.</p>
    <div class="video-container"><video src={sessionVideoUrl} controls preload="metadata" /></div>
  </section>}
</div>

<style>
  .filmstrip-video-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .filmstrip-section,
  .video-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }
  .filmstrip-timeline {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding: 0.5rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .filmstrip-timeline::-webkit-scrollbar {
    height: 6px;
  }
  .filmstrip-timeline::-webkit-scrollbar-track {
    background: var(--background);
    border-radius: 3px;
  }
  .filmstrip-timeline::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }
  .frame-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    flex-shrink: 0;
    min-width: 90px;
  }
  .frame-image {
    height: 70px;
    width: auto;
    max-width: 125px;
    min-width: 90px;
    object-fit: contain;
    display: block;
    border: 2px solid transparent;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      var(--panel) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      var(--panel) 100%
    );
    background-size: 200% 100%;
    animation:
      shimmer 1.5s infinite,
      fadeIn 0.3s ease-in forwards;
  }
  @keyframes fadeIn {
    to {
      background: none;
    }
  }
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  .frame-image.fcp {
    border-color: var(--color-warning);
    border-width: 3px;
  }
  .frame-image.lcp {
    border-color: var(--brand);
    border-width: 3px;
  }
  .frame-image.shift {
    border-color: var(--color-danger);
    border-width: 3px;
  }

  .frame-timestamp {
    font-size: 0.5625rem;
    color: var(--muted);
    font-family: 'SF Mono', Monaco, 'Courier New', monospace;
    line-height: 1;
  }
  .frame-label {
    font-size: 0.5rem;
    font-weight: 500;
    padding: 0.0625rem 0.1875rem;
    border-radius: 0.125rem;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .frame-label.fcp {
    background: rgba(251, 191, 36, 0.2);
    color: var(--color-warning);
  }
  .frame-label.lcp {
    background: rgba(99, 102, 241, 0.2);
    color: var(--brand);
  }
  .frame-label.shift {
    background: rgba(239, 68, 68, 0.2);
    color: var(--color-danger);
  }
  .video-container {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .video-container video {
    width: 100%;
    max-width: 1000px;
    border-radius: 0.375rem;
  }
  .empty-state {
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
    padding: 2.5rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
</style>
